# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Supabase (Service Role Key는 절대 클라이언트에 노출하지 않는다)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# /api/cron/daily-briefing 보호용. 아무 랜덤 문자열이나 사용한다.
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 로그인 (사용자 1명. 회원 테이블 없이 이 값과 비교한다)
AUTH_ID=
AUTH_PASSWORD=
# 세션 쿠키 서명용 32자 이상 랜덤 문자열
AUTH_SECRET=
